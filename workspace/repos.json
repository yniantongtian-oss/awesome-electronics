{
  "schema_version": 1,
  "workspace_name": "AI-EDA Workspace",
  "default_backend": "altium",
  "repositories": [
    {
      "name": "eda-agent",
      "url": "https://github.com/yniantongtian-oss/eda-agent.git",
      "branch": "main",
      "role": "primary-eda-control",
      "default_install": true,
      "update_policy": "fast-forward-only"
    },
    {
      "name": "contextgraph",
      "url": "https://github.com/yniantongtian-oss/contextgraph.git",
      "branch": "main",
      "role": "code-context-retrieval",
      "default_install": true,
      "update_policy": "fast-forward-only"
    },
    {
      "name": "KiKit",
      "url": "https://github.com/yniantongtian-oss/KiKit.git",
      "branch": "master",
      "role": "manufacturing-panelization",
      "default_install": false,
      "update_policy": "fast-forward-only"
    },
    {
      "name": "hardware-components",
      "url": "https://github.com/antmicro/hardware-components.git",
      "branch": "main",
      "role": "external-component-assets",
      "default_install": false,
      "clone_policy": "partial-or-sparse",
      "source_policy": "canonical-upstream-reference"
    },
    {
      "name": "kicad-mcp-1",
      "url": "https://github.com/blwfish/kicad-mcp.git",
      "branch": "main",
      "role": "benchmark-alternative",
      "default_install": false,
      "production_enabled": false,
      "source_policy": "canonical-upstream-reference"
    },
    {
      "name": "KiCAD-MCP-Server",
      "url": "https://github.com/mixelpixx/KiCAD-MCP-Server.git",
      "branch": "main",
      "role": "feature-reference",
      "default_install": false,
      "production_enabled": false,
      "source_policy": "canonical-upstream-reference"
    }
  ]
}
